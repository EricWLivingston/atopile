# EE-agent RAG (M4) — copy to .env at the repo root and fill in.
# The notebook and ingest CLI read these from the environment.

# OpenAI: embeddings (text-embedding-3-large) + optional chunk summaries
OPENAI_API_KEY=

# LlamaParse / LlamaCloud: PDF -> markdown parsing
LLAMA_CLOUD_API_KEY=

# Cohere: reranker (free tier is plenty for dev)
COHERE_API_KEY=

# --- dynamic model routing (EE agent; anthropic provider only, off by default) ---
# EE_AGENT_DYNAMIC_MODEL=1                          # route each turn by complexity
# ATOPILE_AGENT_MODEL_SIMPLE=claude-haiku-4-5-20251001
# ATOPILE_AGENT_MODEL_COMPLEX=claude-opus-4-8
# ATOPILE_AGENT_ROUTER_MODEL=claude-haiku-4-5-20251001  # the classifier model

# --- optional tunables (defaults shown) ---
# EE_EMBED_DIM=1024          # text-embedding-3-large truncation (256..3072)
# EE_RAG_SUMMARIES=0         # 1 to generate per-chunk LLM summaries at ingest
# EE_DATA_ROOT=<repo>/data   # corpus PDFs + caches; defaults to the source tree's
#                            # data/ dir (cwd-independent, so the backend finds the
#                            # store regardless of which project is opened)
